---
import { postUrl, formatPostDate, excerpt, type Post } from '../lib/posts.ts';

interface Props {
  posts: Post[];
  showPin?: boolean;
}

const { posts, showPin = false } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li class={showPin ? 'is-pinned' : undefined}>
      {showPin && (
        <span class="pin" role="img" aria-label="Pinned" title="Pinned">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5" />
            <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" />
          </svg>
        </span>
      )}
      <a href={postUrl(post)} class="post-link">{post.data.title}</a>
      <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
      <p>{excerpt(post)}</p>
    </li>
  ))}
</ul>
