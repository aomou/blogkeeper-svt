---
import '../styles/global.css';
import { siteConfig } from '../../site.config.ts';
import { builtAt, formatDate } from '../lib/posts.ts';

interface Props {
  title?: string;
  description?: string;
  // 分享預覽圖的路徑,未提供時使用站台預設圖
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home', current: pathname === '/' },
  { href: '/posts/', label: 'Posts', current: pathname.startsWith('/posts/') },
  { href: '/tags/', label: 'Tags', current: pathname.startsWith('/tags/') },
  { href: '/about/', label: 'About', current: pathname.startsWith('/about/') },
];
---
<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <noscript>
      <style>
        @media (max-width: 40rem) {
          #site-nav { display: flex !important; flex-direction: row; flex-basis: auto; order: 0; }
          #nav-toggle { display: none !important; }
        }
      </style>
    </noscript>
    <script is:inline data-cfasync="false">
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={title ?? siteConfig.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">{siteConfig.title}</a>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}><span>{item.label}</span></a>
        ))}
      </nav>
      <div class="header-actions">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch color theme">
          <span class="theme-icon">
            <svg class="theme-icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z" />
            </svg>
            <svg class="theme-icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor" />
              <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 2.5v2.2M12 19.3v2.2M4.8 4.8l1.6 1.6M17.6 17.6l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.8 19.2l1.6-1.6M17.6 6.4l1.6-1.6" />
              </g>
            </svg>
          </span>
        </button>
        <button
          type="button"
          class="btn-secondary nav-toggle"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <script is:inline data-cfasync="false">
      (function () {
        var root = document.documentElement;
        var themeToggle = document.getElementById('theme-toggle');
        var navToggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('site-nav');
        var narrow = matchMedia('(max-width: 40rem)');

        function labelTheme(theme) {
          themeToggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }

        function applyTheme(theme, persist) {
          root.setAttribute('data-theme', theme);
          root.style.colorScheme = theme;
          if (persist) {
            try { localStorage.setItem('theme', theme); } catch (e) {}
          }
          labelTheme(theme);
        }

        labelTheme(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

        themeToggle.addEventListener('click', function () {
          applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', true);
        });

        var scheme = matchMedia('(prefers-color-scheme: dark)');
        function onSchemeChange(event) {
          var stored = null;
          try { stored = localStorage.getItem('theme'); } catch (e) {}
          if (stored === 'light' || stored === 'dark') return;
          applyTheme(event.matches ? 'dark' : 'light', false);
        }
        if (scheme.addEventListener) scheme.addEventListener('change', onSchemeChange);

        function setNav(open) {
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.classList.toggle('is-open', open);
        }

        navToggle.addEventListener('click', function (event) {
          var open = navToggle.getAttribute('aria-expanded') !== 'true';
          setNav(open);
          if (open && event.detail === 0) {
            var first = nav.querySelector('a');
            if (first) first.focus();
          }
        });

        nav.addEventListener('click', function (event) {
          var link = event.target.closest && event.target.closest('a');
          if (link && nav.contains(link)) setNav(false);
        });

        document.addEventListener('click', function (event) {
          if (navToggle.getAttribute('aria-expanded') !== 'true') return;
          if (nav.contains(event.target) || navToggle.contains(event.target)) return;
          setNav(false);
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
            setNav(false);
            navToggle.focus();
          }
        });

        function onNarrowChange(event) {
          if (!event.matches) setNav(false);
        }
        if (narrow.addEventListener) narrow.addEventListener('change', onNarrowChange);
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Contact: <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>
      <p>Last updated: <time datetime={builtAt.toISOString()}>{formatDate(builtAt)}</time></p>
    </footer>
  </body>
</html>
