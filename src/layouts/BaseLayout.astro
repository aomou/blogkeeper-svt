---
import '../styles/global.css';
import { siteConfig } from '../../site.config.ts';
import { builtAt, formatDate } from '../lib/posts.ts';

interface Props {
  title?: string;
  description?: string;
  // 分享預覽圖的路徑,未提供時使用站台預設圖
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首頁', current: pathname === '/' },
  { href: '/tags/', label: '標籤', current: pathname.startsWith('/tags/') },
  { href: '/posts/', label: '文章', current: pathname.startsWith('/posts/') },
];
---
<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={title ?? siteConfig.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">{siteConfig.title}</a>
      <nav id="site-nav" class="site-nav" aria-label="主要導覽">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <button type="button" class="btn-secondary theme-toggle" id="theme-toggle" aria-label="切換色彩主題">
          <span class="theme-to-dark">深色</span>
          <span class="theme-to-light">淺色</span>
        </button>
        <button
          type="button"
          class="btn-secondary nav-toggle"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="開啟選單"
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var themeToggle = document.getElementById('theme-toggle');
        var navToggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('site-nav');
        var narrow = matchMedia('(max-width: 40rem)');

        function labelTheme(theme) {
          themeToggle.setAttribute('aria-label', theme === 'dark' ? '切換為淺色主題' : '切換為深色主題');
        }

        function applyTheme(theme, persist) {
          root.setAttribute('data-theme', theme);
          root.style.colorScheme = theme;
          if (persist) {
            try { localStorage.setItem('theme', theme); } catch (e) {}
          }
          labelTheme(theme);
        }

        labelTheme(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

        themeToggle.addEventListener('click', function () {
          applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', true);
        });

        var scheme = matchMedia('(prefers-color-scheme: dark)');
        function onSchemeChange(event) {
          var stored = null;
          try { stored = localStorage.getItem('theme'); } catch (e) {}
          if (stored === 'light' || stored === 'dark') return;
          applyTheme(event.matches ? 'dark' : 'light', false);
        }
        if (scheme.addEventListener) scheme.addEventListener('change', onSchemeChange);

        function setNav(open) {
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          navToggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
          nav.classList.toggle('is-open', open);
        }

        navToggle.addEventListener('click', function (event) {
          var open = navToggle.getAttribute('aria-expanded') !== 'true';
          setNav(open);
          if (open && event.detail === 0) {
            var first = nav.querySelector('a');
            if (first) first.focus();
          }
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
            setNav(false);
            navToggle.focus();
          }
        });

        function onNarrowChange(event) {
          if (!event.matches) setNav(false);
        }
        if (narrow.addEventListener) narrow.addEventListener('change', onNarrowChange);

        root.setAttribute('data-nav', 'ready');
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>聯絡:<a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>
      <p>最後更新:<time datetime={builtAt.toISOString()}>{formatDate(builtAt, true)}</time></p>
    </footer>
  </body>
</html>
